<div class="wws-editor-inner">
<div class="wws-editor-body">
  <div class="form-group">
    <label>{{localize "WITCHWIND_SYSTEMS.Editor.Title"}}</label>
    <input type="text" name="title" value="{{entry.title}}" required placeholder="{{localize "WITCHWIND_SYSTEMS.Calendar.EventPlaceholder"}}">
  </div>

  {{> "modules/witchwind-systems/templates/editors/date.hbs" date=date prefix="" required=true}}

  <label class="wws-toggle">
    <input type="checkbox" name="yearly" {{#if entry.yearly}}checked{{/if}}>
    <span>{{localize "WITCHWIND_SYSTEMS.Calendar.YearlyLabel"}}</span>
  </label>
  <p class="hint">{{localize "WITCHWIND_SYSTEMS.Calendar.YearlyHint"}}</p>

  <fieldset class="wws-choices">
    <legend>{{localize "WITCHWIND_SYSTEMS.Maps.Icon"}}</legend>
    <div class="wws-icon-grid">
      {{#each icons}}
      <label class="wws-icon-choice">
        <input type="radio" name="icon" value="{{value}}" {{#if checked}}checked{{/if}} aria-label="{{value}}">
        <i class="{{value}}" inert></i>
      </label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset class="wws-choices">
    <legend>{{localize "WITCHWIND_SYSTEMS.Maps.Color"}}</legend>
    <div class="wws-color-row">
      {{#each colors}}
      <label class="wws-color-choice" data-tooltip="{{label}}" style="--wws-swatch: {{value}};">
        <input type="radio" name="color" value="{{id}}" {{#if checked}}checked{{/if}} aria-label="{{localize label}}">
        <span></span>
      </label>
      {{/each}}
    </div>
  </fieldset>

  {{> "modules/witchwind-systems/templates/editors/visibility.hbs"}}

  <div class="form-group stacked">
    <label>{{localize "WITCHWIND_SYSTEMS.Quests.Description"}}</label>
    <textarea name="description" rows="4" placeholder="{{localize "WITCHWIND_SYSTEMS.Calendar.DescriptionPlaceholder"}}">{{entry.description}}</textarea>
  </div>
</div>

<footer class="wws-editor-footer">
  <button type="submit"><i class="fa-solid fa-calendar-plus" inert></i> {{#if isNew}}{{localize "WITCHWIND_SYSTEMS.Calendar.CreateEvent"}}{{else}}{{localize "WITCHWIND_SYSTEMS.Save"}}{{/if}}</button>
</footer>
</div>
