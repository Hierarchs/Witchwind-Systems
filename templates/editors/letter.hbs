<div class="wws-editor-inner">
<div class="wws-editor-body">
  <div class="form-group">
    <label>{{localize "WITCHWIND_SYSTEMS.Editor.Title"}}</label>
    <input type="text" name="title" value="{{entry.title}}" required placeholder="{{localize "WITCHWIND_SYSTEMS.Letters.TitlePlaceholder"}}">
  </div>
  <div class="wws-form-row">
    <div class="form-group">
      <label>{{localize "WITCHWIND_SYSTEMS.Letters.Kind"}}</label>
      <select name="kind">{{#each kinds}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
    </div>
    <div class="form-group">
      <label>{{localize "WITCHWIND_SYSTEMS.Letters.Sender"}}</label>
      <input type="text" name="sender" value="{{entry.sender}}" placeholder="{{localize "WITCHWIND_SYSTEMS.Letters.SenderPlaceholder"}}">
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "WITCHWIND_SYSTEMS.Letters.ArriveIn"}}</label>
    <input type="number" name="arriveIn" value="{{arriveIn}}" min="0" step="1">
  </div>
  <p class="hint">{{localize "WITCHWIND_SYSTEMS.Letters.ArriveHint" today=today}}</p>

  {{> "modules/witchwind-systems/templates/editors/visibility.hbs"}}

  <div class="form-group stacked">
    <label>{{localize "WITCHWIND_SYSTEMS.Letters.Seal"}}</label>
    {{> "modules/witchwind-systems/templates/editors/image.hbs"}}
  </div>
  <div class="form-group stacked">
    <label>{{localize "WITCHWIND_SYSTEMS.Letters.Body"}}</label>
    <prose-mirror name="body" value="{{entry.body}}"></prose-mirror>
  </div>
</div>
<footer class="wws-editor-footer">
  <button type="submit"><i class="fa-solid fa-envelope" inert></i> {{#if isNew}}{{localize "WITCHWIND_SYSTEMS.Letters.Send"}}{{else}}{{localize "WITCHWIND_SYSTEMS.Save"}}{{/if}}</button>
</footer>
</div>
