<div class="wws-editor-inner">
<div class="wws-editor-body">
  <p class="hint">{{localize "WITCHWIND_SYSTEMS.Editor.LogHint"}}</p>
  <div class="form-group stacked">
    <textarea name="text" rows="6" required placeholder="{{localize "WITCHWIND_SYSTEMS.Editor.EntryPlaceholder"}}"></textarea>
  </div>
  <label class="wws-toggle">
    <input type="checkbox" name="hidden">
    <span>{{localize "WITCHWIND_SYSTEMS.Editor.HiddenEntry"}}</span>
  </label>
</div>

<footer class="wws-editor-footer">
  <button type="submit"><i class="fa-solid fa-feather" inert></i> {{localize "WITCHWIND_SYSTEMS.Quests.AddEntry"}}</button>
</footer>
</div>
