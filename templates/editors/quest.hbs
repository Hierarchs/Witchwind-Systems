<div class="wws-editor-inner">
<div class="wws-editor-body">
  <nav class="wws-editor-tabs">
    <button type="button" class="active" data-action="editorTab" data-tab="details" aria-pressed="true">{{localize "WITCHWIND_SYSTEMS.Editor.Details"}}</button>
    <button type="button" data-action="editorTab" data-tab="objectives" aria-pressed="false">{{localize "WITCHWIND_SYSTEMS.Quests.Objectives"}}</button>
    <button type="button" data-action="editorTab" data-tab="log" aria-pressed="false">{{localize "WITCHWIND_SYSTEMS.Quests.Journal"}}</button>
    <button type="button" data-action="editorTab" data-tab="rewards" aria-pressed="false">{{localize "WITCHWIND_SYSTEMS.Quests.Rewards"}}</button>
    <button type="button" data-action="editorTab" data-tab="gm" aria-pressed="false">{{localize "WITCHWIND_SYSTEMS.GMNotes"}}</button>
  </nav>

  {{!-- Details --}}
  <section class="wws-panel active" data-panel="details">
    <div class="form-group">
      <label>{{localize "WITCHWIND_SYSTEMS.Editor.Title"}}</label>
      <input type="text" name="title" value="{{entry.title}}" required placeholder="{{localize "WITCHWIND_SYSTEMS.Quests.TitlePlaceholder"}}">
    </div>
    <div class="wws-form-row">
      <div class="form-group">
        <label>{{localize "WITCHWIND_SYSTEMS.Quests.Kind"}}</label>
        <select name="kind">
          {{#each kinds}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
        </select>
      </div>
      <div class="form-group">
        <label>{{localize "WITCHWIND_SYSTEMS.Quests.StatusLabel"}}</label>
        <select name="status">
          {{#each statuses}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
        </select>
      </div>
    </div>
    <label class="wws-toggle">
      <input type="checkbox" name="visible" {{#if entry.visible}}checked{{/if}}>
      <span>{{localize "WITCHWIND_SYSTEMS.Editor.VisibleQuest"}}</span>
    </label>

    <div class="wws-form-row">
      <div class="form-group wws-giver-group">
        <label>{{localize "WITCHWIND_SYSTEMS.Quests.Giver"}}</label>
        <div class="wws-giver" data-drop="giver">
          <img src="{{#if entry.giverImg}}{{entry.giverImg}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="" {{#unless entry.giverImg}}hidden{{/unless}}>
          <input type="text" name="giverName" value="{{entry.giverName}}" placeholder="{{localize "WITCHWIND_SYSTEMS.Quests.GiverPlaceholder"}}">
          <input type="hidden" name="giverImg" value="{{entry.giverImg}}">
          <input type="hidden" name="giverUuid" value="{{entry.giverUuid}}">
          <button type="button" class="wws-mini-button" data-action="clearGiver" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Clear"}}"><i class="fa-solid fa-xmark" inert></i></button>
        </div>
      </div>
      <div class="form-group">
        <label>{{localize "WITCHWIND_SYSTEMS.Quests.Location"}}</label>
        <input type="text" name="location" value="{{entry.location}}" placeholder="{{localize "WITCHWIND_SYSTEMS.Quests.LocationPlaceholder"}}">
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "WITCHWIND_SYSTEMS.Quests.Faction"}}</label>
      <select name="faction">
        <option value="">{{localize "WITCHWIND_SYSTEMS.None"}}</option>
        {{#each factions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </div>

    <div class="form-group stacked">
      <label>{{localize "WITCHWIND_SYSTEMS.Editor.Picture"}}</label>
      {{> "modules/witchwind-systems/templates/editors/image.hbs"}}
    </div>

    <div class="form-group stacked">
      <label>{{localize "WITCHWIND_SYSTEMS.Quests.Description"}}</label>
      <prose-mirror name="description" value="{{entry.description}}"></prose-mirror>
    </div>
  </section>

  {{!-- Objectives --}}
  <section class="wws-panel" data-panel="objectives">
    <p class="hint">{{localize "WITCHWIND_SYSTEMS.Editor.ObjectivesHint"}}</p>
    <ol class="wws-rows" data-list="objectives">
      {{#each objectives}}
      <li class="wws-edit-row" data-list-row>
        <input type="hidden" data-field="id" value="{{id}}">
        <input type="text" data-field="text" value="{{text}}" placeholder="{{localize "WITCHWIND_SYSTEMS.Editor.ObjectivePlaceholder"}}">
        <label data-tooltip="WITCHWIND_SYSTEMS.Quests.Done"><input type="checkbox" data-field="done" {{#if done}}checked{{/if}}><i class="fa-solid fa-check" inert></i></label>
        <label data-tooltip="WITCHWIND_SYSTEMS.Quests.Failed"><input type="checkbox" data-field="failed" {{#if failed}}checked{{/if}}><i class="fa-solid fa-xmark" inert></i></label>
        <label data-tooltip="WITCHWIND_SYSTEMS.Quests.Optional"><input type="checkbox" data-field="optional" {{#if optional}}checked{{/if}}><i class="fa-solid fa-circle-half-stroke" inert></i></label>
        <label data-tooltip="WITCHWIND_SYSTEMS.HiddenFromPlayers"><input type="checkbox" data-field="hidden" {{#if hidden}}checked{{/if}}><i class="fa-solid fa-eye-slash" inert></i></label>
        <span class="wws-row-buttons">
          <button type="button" data-action="moveRow" data-direction="up" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.MoveUp"}}"><i class="fa-solid fa-chevron-up" inert></i></button>
          <button type="button" data-action="moveRow" data-direction="down" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.MoveDown"}}"><i class="fa-solid fa-chevron-down" inert></i></button>
          <button type="button" data-action="removeRow" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </span>
      </li>
      {{/each}}
    </ol>
    <button type="button" class="wws-add" data-action="addRow" data-list="objectives"><i class="fa-solid fa-plus" inert></i> {{localize "WITCHWIND_SYSTEMS.Editor.AddObjective"}}</button>
    <template data-row-template="objectives">
      <li class="wws-edit-row" data-list-row>
        <input type="hidden" data-field="id" value="">
        <input type="text" data-field="text" value="" placeholder="{{localize "WITCHWIND_SYSTEMS.Editor.ObjectivePlaceholder"}}">
        <label data-tooltip="WITCHWIND_SYSTEMS.Quests.Done"><input type="checkbox" data-field="done"><i class="fa-solid fa-check" inert></i></label>
        <label data-tooltip="WITCHWIND_SYSTEMS.Quests.Failed"><input type="checkbox" data-field="failed"><i class="fa-solid fa-xmark" inert></i></label>
        <label data-tooltip="WITCHWIND_SYSTEMS.Quests.Optional"><input type="checkbox" data-field="optional"><i class="fa-solid fa-circle-half-stroke" inert></i></label>
        <label data-tooltip="WITCHWIND_SYSTEMS.HiddenFromPlayers"><input type="checkbox" data-field="hidden"><i class="fa-solid fa-eye-slash" inert></i></label>
        <span class="wws-row-buttons">
          <button type="button" data-action="moveRow" data-direction="up" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.MoveUp"}}"><i class="fa-solid fa-chevron-up" inert></i></button>
          <button type="button" data-action="moveRow" data-direction="down" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.MoveDown"}}"><i class="fa-solid fa-chevron-down" inert></i></button>
          <button type="button" data-action="removeRow" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </span>
      </li>
    </template>
  </section>

  {{!-- Journal entries --}}
  <section class="wws-panel" data-panel="log">
    <p class="hint">{{localize "WITCHWIND_SYSTEMS.Editor.LogHint"}}</p>
    <ol class="wws-rows" data-list="log">
      {{#each log}}
      <li class="wws-edit-row wws-edit-row-tall" data-list-row>
        <input type="hidden" data-field="id" value="{{id}}">
        <input type="hidden" data-field="date" value="{{date}}">
        <textarea data-field="text" rows="3">{{text}}</textarea>
        <label data-tooltip="WITCHWIND_SYSTEMS.HiddenFromPlayers"><input type="checkbox" data-field="hidden" {{#if hidden}}checked{{/if}}><i class="fa-solid fa-eye-slash" inert></i></label>
        <span class="wws-row-buttons">
          <button type="button" data-action="removeRow" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </span>
      </li>
      {{/each}}
    </ol>
    <button type="button" class="wws-add" data-action="addRow" data-list="log"><i class="fa-solid fa-plus" inert></i> {{localize "WITCHWIND_SYSTEMS.Quests.AddEntry"}}</button>
    <template data-row-template="log">
      <li class="wws-edit-row wws-edit-row-tall" data-list-row>
        <input type="hidden" data-field="id" value="">
        <input type="hidden" data-field="date" value="">
        <textarea data-field="text" rows="3" placeholder="{{localize "WITCHWIND_SYSTEMS.Editor.EntryPlaceholder"}}"></textarea>
        <label data-tooltip="WITCHWIND_SYSTEMS.HiddenFromPlayers"><input type="checkbox" data-field="hidden"><i class="fa-solid fa-eye-slash" inert></i></label>
        <span class="wws-row-buttons">
          <button type="button" data-action="removeRow" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </span>
      </li>
    </template>
  </section>

  {{!-- Rewards --}}
  <section class="wws-panel" data-panel="rewards">
    <div class="wws-drop-zone" data-drop="rewards">
      <i class="fa-solid fa-hand-holding-heart" inert></i> {{localize "WITCHWIND_SYSTEMS.Editor.RewardsDrop"}}
    </div>
    <ol class="wws-rows" data-list="rewards">
      {{#each rewards}}
      <li class="wws-edit-row" data-list-row>
        <input type="hidden" data-field="uuid" value="{{uuid}}">
        <input type="hidden" data-field="img" value="{{img}}">
        <input type="hidden" data-field="rarity" value="{{rarity}}">
        <img class="wws-row-img" src="{{#if img}}{{img}}{{else}}icons/svg/item-bag.svg{{/if}}" data-show="img" alt="">
        <input type="text" data-field="name" value="{{name}}" placeholder="{{localize "WITCHWIND_SYSTEMS.Editor.RewardPlaceholder"}}">
        <input type="number" class="wws-qty-input" data-field="qty" value="{{qty}}" min="1" step="1" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Quantity"}}">
        <span class="wws-row-buttons">
          <button type="button" data-action="removeRow" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </span>
      </li>
      {{/each}}
    </ol>
    <button type="button" class="wws-add" data-action="addRow" data-list="rewards"><i class="fa-solid fa-plus" inert></i> {{localize "WITCHWIND_SYSTEMS.Editor.AddReward"}}</button>
    <template data-row-template="rewards">
      <li class="wws-edit-row" data-list-row>
        <input type="hidden" data-field="uuid" value="">
        <input type="hidden" data-field="img" value="">
        <input type="hidden" data-field="rarity" value="">
        <img class="wws-row-img" src="icons/svg/item-bag.svg" data-show="img" alt="">
        <input type="text" data-field="name" value="" placeholder="{{localize "WITCHWIND_SYSTEMS.Editor.RewardPlaceholder"}}">
        <input type="number" class="wws-qty-input" data-field="qty" value="1" min="1" step="1" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Quantity"}}">
        <span class="wws-row-buttons">
          <button type="button" data-action="removeRow" aria-label="{{localize "WITCHWIND_SYSTEMS.Editor.Remove"}}"><i class="fa-solid fa-trash" inert></i></button>
        </span>
      </li>
    </template>
  </section>

  {{!-- GM notes --}}
  <section class="wws-panel" data-panel="gm">
    <p class="hint">{{localize "WITCHWIND_SYSTEMS.Editor.GMNotesHint"}}</p>
    <prose-mirror name="gmNotes" value="{{entry.gmNotes}}"></prose-mirror>
  </section>
</div>

<footer class="wws-editor-footer">
  <button type="submit"><i class="fa-solid fa-feather-pointed" inert></i> {{#if isNew}}{{localize "WITCHWIND_SYSTEMS.Quests.Create"}}{{else}}{{localize "WITCHWIND_SYSTEMS.Save"}}{{/if}}</button>
</footer>
</div>
