<div class="wws-book" data-section="{{sectionId}}">
  {{!-- The tabs across the top, on a leather bar over a double gold rule. --}}
  <header class="wws-topbar">
    <span class="wws-topbar-hint"><kbd>Esc</kbd> {{localize "WITCHWIND_SYSTEMS.Close"}}</span>
    <nav class="wws-tabs" aria-label="{{localize "WITCHWIND_SYSTEMS.Title"}}">
      {{#each tabs}}
      <button type="button" class="wws-tab{{#if active}} active{{/if}}" data-action="section" data-section="{{id}}"
              data-tooltip="{{label}}" aria-label="{{localize label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
        <i class="{{icon}}" inert></i>
        <span>{{localize label}}</span>
      </button>
      {{/each}}
    </nav>
    <button type="button" class="wws-close" data-action="close" aria-label="{{localize "WITCHWIND_SYSTEMS.Close"}}">
      <i class="fa-solid fa-xmark" inert></i>
    </button>
  </header>

  <div class="wws-pages">
    {{#if sectionTemplate}}
    {{> (lookup this "sectionTemplate")}}
    {{else}}
    <p class="wws-empty wws-empty-book">{{localize "WITCHWIND_SYSTEMS.NoSections"}}</p>
    {{/if}}
  </div>
</div>
