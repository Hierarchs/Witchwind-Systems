<div class="wws-party-frame{{#if collapsed}} collapsed{{/if}}{{#if row}} wws-party-row{{/if}}" style="--wws-party-scale: {{scale}};">
  <header class="wws-party-head" data-tooltip="WITCHWIND_SYSTEMS.Party.DragHint">
    {{#if canRename}}
    <button type="button" class="wws-party-title" data-action="partyRename" data-tooltip="WITCHWIND_SYSTEMS.Party.Rename">{{title}}</button>
    {{else}}
    <h2 class="wws-party-title">{{title}}</h2>
    {{/if}}
    <span class="wws-party-tools">
      <button type="button" class="wws-tool wws-mini" data-action="partySize" data-delta="-1" data-tooltip="WITCHWIND_SYSTEMS.Party.Smaller"
              aria-label="{{localize "WITCHWIND_SYSTEMS.Party.Smaller"}}" {{#if atMin}}disabled{{/if}}>
        <i class="fa-solid fa-minus" inert></i>
      </button>
      <button type="button" class="wws-tool wws-mini" data-action="partySize" data-delta="1" data-tooltip="WITCHWIND_SYSTEMS.Party.Larger"
              aria-label="{{localize "WITCHWIND_SYSTEMS.Party.Larger"}}" {{#if atMax}}disabled{{/if}}>
        <i class="fa-solid fa-plus" inert></i>
      </button>
      <button type="button" class="wws-tool wws-mini" data-action="partyCollapse"
              aria-label="{{localize "WITCHWIND_SYSTEMS.Party.Collapse"}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
        <i class="fa-solid {{#if collapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}" inert></i>
      </button>
      <button type="button" class="wws-tool wws-mini" data-action="partyHide" data-tooltip="WITCHWIND_SYSTEMS.Party.Hide"
              aria-label="{{localize "WITCHWIND_SYSTEMS.Party.Hide"}}">
        <i class="fa-solid fa-xmark" inert></i>
      </button>
    </span>
  </header>

  {{#unless collapsed}}
  {{#if empty}}
  <p class="wws-party-empty">{{localize "WITCHWIND_SYSTEMS.Party.Empty"}}</p>
  {{else}}
  <ol class="wws-party-list">
    {{#each members}}
    <li class="wws-party-member wws-hp-{{state}}" data-actor-id="{{id}}" style="--wws-hp: {{ratio}}; --wws-temp: {{tempRatio}};">
      <span class="wws-party-flash" aria-hidden="true"></span>
      <div class="wws-party-top">
        <button type="button" class="wws-party-portrait" data-action="partySheet" data-uuid="{{uuid}}"
                aria-label="{{name}}" {{#unless canOpen}}disabled{{/unless}}>
          <img src="{{img}}" alt="">
        </button>
        <span class="wws-party-name">{{name}}</span>
      </div>
      {{#if hasHp}}
      <div class="wws-party-stat">
        <span class="wws-party-label wws-party-label-hp">{{localize "WITCHWIND_SYSTEMS.Party.HP"}}</span>
        {{#if showNumbers}}<span class="wws-party-value"><span class="wws-party-hp-value">{{value}}</span><span class="wws-party-max">/{{max}}</span></span>{{/if}}
      </div>
      <div class="wws-party-bar wws-party-hp-bar" role="meter" aria-label="{{localize "WITCHWIND_SYSTEMS.Party.HitPoints"}}" aria-valuemin="0"
           {{#if showNumbers}}aria-valuemax="{{max}}" aria-valuenow="{{value}}"{{else}}aria-valuemax="100" aria-valuenow="{{pct}}"{{/if}}>
        <span class="wws-party-trail"></span>
        <span class="wws-party-fill"></span>
      </div>
      <div class="wws-party-stat wws-party-temp-row{{#unless temp}} wws-party-none{{/unless}}">
        <span class="wws-party-label wws-party-label-temp" data-tooltip="WITCHWIND_SYSTEMS.Party.Temp">{{localize "WITCHWIND_SYSTEMS.Party.TempShort"}}</span>
        {{#if showNumbers}}<span class="wws-party-value"><span class="wws-party-temp-value">{{temp}}</span></span>{{/if}}
      </div>
      <div class="wws-party-bar wws-party-temp-bar" role="meter" aria-label="{{localize "WITCHWIND_SYSTEMS.Party.Temp"}}" aria-valuemin="0"
           {{#if showNumbers}}aria-valuemax="{{max}}" aria-valuenow="{{temp}}"{{else}}aria-valuemax="100" aria-valuenow="{{tempPct}}"{{/if}}>
        <span class="wws-party-fill"></span>
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{/if}}
  {{/unless}}
</div>
