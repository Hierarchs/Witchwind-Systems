<div class="wws-spread wws-journal">

  {{!-- Left page: notes and letters, in one list --}}
  <section class="wws-page wws-page-list">
    <header class="wws-page-head">
      <h2>{{localize "WITCHWIND_SYSTEMS.Sections.journal"}}</h2>
      <span class="wws-head-tools">
        {{#if page.canLetter}}
        <button type="button" class="wws-tool" data-action="letterNew" data-tooltip="WITCHWIND_SYSTEMS.Journal.NewLetter">
          <i class="fa-solid fa-envelope" inert></i>
        </button>
        {{/if}}
        {{#if page.canCreate}}
        <button type="button" class="wws-ink" data-action="noteNew">
          <i class="fa-solid fa-plus" inert></i> {{localize "WITCHWIND_SYSTEMS.Journal.NewShort"}}
        </button>
        {{/if}}
      </span>
    </header>

    <nav class="wws-filters wws-filters-icons">
      {{#each page.filters}}
      <button type="button" class="wws-filter{{#if active}} active{{/if}}" data-action="noteFilter" data-filter="{{id}}"
              data-tooltip="{{label}}" aria-label="{{localize label}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
        <i class="{{icon}}" inert></i>{{#if count}}<span class="wws-count">{{count}}</span>{{/if}}
      </button>
      {{/each}}
    </nav>

    <label class="wws-search">
      <i class="fa-solid fa-magnifying-glass" inert></i>
      <input type="search" data-focus-key="journal" value="{{page.search}}"
             placeholder="{{localize "WITCHWIND_SYSTEMS.Journal.Search"}}" aria-label="{{localize "WITCHWIND_SYSTEMS.Journal.Search"}}">
    </label>

    <div class="wws-list-scroll">
      {{#if page.empty}}
      <p class="wws-empty">{{#if page.search}}{{localize "WITCHWIND_SYSTEMS.Journal.NoMatches"}}{{else}}{{localize "WITCHWIND_SYSTEMS.Journal.Empty"}}{{/if}}</p>
      {{/if}}
      <ol class="wws-list">
        {{#each page.rows}}
        <li>
          {{#if (eq type "letter")}}
          <button type="button" class="wws-row wws-letter-row{{#if selected}} selected{{/if}}{{#if unread}} wws-unread{{/if}}" data-action="noteSelect" data-id="{{id}}">
            <i class="{{icon}} wws-row-icon" inert></i>
            <span class="wws-row-text">
              <span class="wws-row-title">{{title}}</span>
              <span class="wws-row-sub">{{#if sender}}{{sender}} · {{/if}}{{dateLabel}}</span>
            </span>
            {{#if unread}}<i class="wws-unread-mark" data-tooltip="WITCHWIND_SYSTEMS.Letters.Unread"></i>{{/if}}
            {{#if pending}}<i class="fa-solid fa-hourglass-half wws-row-mark" data-tooltip="WITCHWIND_SYSTEMS.Letters.NotDelivered"></i>{{/if}}
          </button>
          {{else}}
          <button type="button" class="wws-row wws-note-row{{#if selected}} selected{{/if}}" data-action="noteSelect" data-id="{{id}}">
            {{#if img}}<img class="wws-thumb" src="{{img}}" alt="" loading="lazy">{{else}}<i class="{{icon}} wws-row-icon" inert></i>{{/if}}
            <span class="wws-row-text">
              <span class="wws-row-title">{{title}}</span>
              <span class="wws-row-sub"><span class="wws-author" style="--wws-author: {{author.color}}">{{author.name}}</span> · {{dateLabel}}</span>
            </span>
            {{#if private}}<i class="fa-solid fa-lock wws-row-mark" data-tooltip="WITCHWIND_SYSTEMS.Journal.PrivateHint"></i>{{/if}}
            {{#if restricted}}<i class="fa-solid fa-user-lock wws-row-mark" data-tooltip="WITCHWIND_SYSTEMS.Visibility.Limited"></i>{{/if}}
          </button>
          {{/if}}
        </li>
        {{/each}}
      </ol>
    </div>

    {{#if page.canCreate}}
    <p class="wws-drop-hint"><i class="fa-solid fa-file-import" inert></i> {{localize "WITCHWIND_SYSTEMS.Journal.DropHint"}}</p>
    {{/if}}
  </section>

  {{!-- Right page: the chosen letter or note --}}
  <section class="wws-page wws-page-detail">
    <div class="wws-detail-scroll">
      {{#with page.letter as |letter|}}
      <article class="wws-entry wws-letter" data-id="{{letter.id}}" {{#if letter.unread}}data-unread{{/if}}>
        {{#if letter.hidden}}<p class="wws-ribbon"><i class="fa-solid fa-eye-slash" inert></i> {{localize "WITCHWIND_SYSTEMS.Letters.NotDelivered"}}</p>
        {{else if letter.arrivesLabel}}<p class="wws-ribbon"><i class="fa-solid fa-hourglass-half" inert></i> {{localize "WITCHWIND_SYSTEMS.Letters.Arrives" date=letter.arrivesLabel}}</p>
        {{else if letter.viewers}}<p class="wws-ribbon"><i class="fa-solid fa-user-lock" inert></i> {{localize "WITCHWIND_SYSTEMS.Visibility.Only" names=letter.viewers}}</p>{{/if}}

        {{#if @root.page.canLetter}}
        <div class="wws-gm-bar">
          <span class="wws-gm-label">{{localize "WITCHWIND_SYSTEMS.GM"}}</span>
          <button type="button" class="wws-tool" data-action="letterEdit" data-id="{{letter.id}}" data-tooltip="WITCHWIND_SYSTEMS.Edit"><i class="fa-solid fa-pen-to-square" inert></i></button>
          {{#if (or letter.hidden letter.arrivesLabel)}}
          <button type="button" class="wws-tool" data-action="letterDeliver" data-id="{{letter.id}}" data-tooltip="WITCHWIND_SYSTEMS.Letters.DeliverNow"><i class="fa-solid fa-paper-plane" inert></i></button>
          {{else}}
          <button type="button" class="wws-tool" data-action="letterShow" data-id="{{letter.id}}" data-tooltip="WITCHWIND_SYSTEMS.ShowToPlayers"><i class="fa-solid fa-bullhorn" inert></i></button>
          {{/if}}
          <span class="wws-gm-gap"></span>
          <button type="button" class="wws-tool wws-bad" data-action="letterDelete" data-id="{{letter.id}}" data-tooltip="WITCHWIND_SYSTEMS.Delete.Title"><i class="fa-solid fa-trash" inert></i></button>
        </div>
        {{/if}}

        {{!-- The letter itself: a sheet of paper on the page, with its seal and the sender signed below. --}}
        <div class="wws-paper wws-paper-{{letter.kind}}">
          {{#if letter.img}}<img class="wws-seal" src="{{letter.img}}" alt="">{{/if}}
          <p class="wws-kicker"><i class="{{letter.icon}}" inert></i> {{localize letter.kindLabel}} <span class="wws-sep" aria-hidden="true">◆</span> {{letter.dateLabel}}</p>
          <h1 class="wws-entry-title">{{letter.title}}</h1>
          <div class="wws-prose">{{{letter.body}}}</div>
          {{#if letter.sender}}<p class="wws-signature">— {{letter.sender}}</p>{{/if}}
        </div>
      </article>
      {{else}}
      {{#with page.note as |note|}}
      <article class="wws-entry wws-note">
        <header class="wws-entry-head">
          <p class="wws-kicker">
            <i class="{{note.icon}}" inert></i> {{localize note.kindLabel}}
            <span class="wws-sep" aria-hidden="true">◆</span>
            {{#if note.private}}
            <span><i class="fa-solid fa-lock" inert></i> {{localize "WITCHWIND_SYSTEMS.Journal.Private"}}</span>
            {{else if note.viewers}}
            <span><i class="fa-solid fa-user-lock" inert></i> {{localize "WITCHWIND_SYSTEMS.Visibility.Only" names=note.viewers}}</span>
            {{else}}
            <span><i class="fa-solid fa-users" inert></i> {{localize "WITCHWIND_SYSTEMS.Journal.Shared"}}</span>
            {{/if}}
          </p>
          <h1 class="wws-entry-title">{{note.title}}</h1>
          <p class="wws-byline">
            <span class="wws-author" style="--wws-author: {{note.author.color}}">{{note.author.name}}</span>
            · {{note.dateLabel}}{{#if note.editedLabel}} · {{localize "WITCHWIND_SYSTEMS.Journal.Edited" date=note.editedLabel}}{{/if}}
          </p>
        </header>

        {{#if (or note.canEdit note.canShow)}}
        <div class="wws-actions">
          {{#if note.canEdit}}
          <button type="button" class="wws-button" data-action="noteEdit" data-id="{{note.id}}">
            <i class="fa-solid fa-pen-to-square" inert></i> {{localize "WITCHWIND_SYSTEMS.Edit"}}
          </button>
          {{/if}}
          {{#if note.canShow}}
          <button type="button" class="wws-button" data-action="noteShow" data-id="{{note.id}}">
            <i class="fa-solid fa-bullhorn" inert></i> {{localize "WITCHWIND_SYSTEMS.ShowToPlayers"}}
          </button>
          {{/if}}
          {{#if note.canEdit}}
          <button type="button" class="wws-tool wws-bad" data-action="noteDelete" data-id="{{note.id}}" data-tooltip="WITCHWIND_SYSTEMS.Delete.Title">
            <i class="fa-solid fa-trash" inert></i>
          </button>
          {{/if}}
        </div>
        {{/if}}

        {{#if note.img}}
        <figure class="wws-plate wws-plate-note">
          <button type="button" data-action="noteImage" data-id="{{note.id}}" data-tooltip="WITCHWIND_SYSTEMS.Journal.ViewImage">
            <img src="{{note.img}}" alt="">
          </button>
        </figure>
        {{/if}}

        {{#if (or note.links.quest note.links.faction note.links.pin)}}
        <ul class="wws-chips wws-note-links">
          {{#if note.links.quest}}
          <li><button type="button" class="wws-chip" data-action="noteQuest" data-quest="{{note.links.quest.id}}"><i class="fa-solid fa-scroll-old" inert></i> {{note.links.quest.title}}</button></li>
          {{/if}}
          {{#if note.links.faction}}
          <li><button type="button" class="wws-chip" data-action="noteFaction" data-faction="{{note.links.faction.id}}"><i class="fa-solid fa-chess-rook" inert></i> {{note.links.faction.name}}</button></li>
          {{/if}}
          {{#if note.links.pin}}
          <li><button type="button" class="wws-chip" data-action="notePin" data-pin="{{note.links.pin.id}}"><i class="fa-solid fa-location-dot" inert></i> {{note.links.pin.label}}</button></li>
          {{/if}}
        </ul>
        {{/if}}

        {{#if note.body}}
        <div class="wws-prose">{{{note.body}}}</div>
        {{else}}
        {{#unless note.img}}<p class="wws-empty">{{localize "WITCHWIND_SYSTEMS.Journal.Blank"}}</p>{{/unless}}
        {{/if}}
      </article>
      {{else}}
      <p class="wws-empty wws-empty-page">
        <i class="fa-solid fa-feather-pointed" inert></i>
        {{#if page.canCreate}}{{localize "WITCHWIND_SYSTEMS.Journal.StartHint"}}{{else}}{{localize "WITCHWIND_SYSTEMS.Journal.NoneHint"}}{{/if}}
      </p>
      {{/with}}
      {{/with}}
    </div>
  </section>
</div>
