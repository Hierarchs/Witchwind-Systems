{{!-- The GM's chips for who can see one fact: everyone, or chosen players. --}}
{{#*inline "wws-beast-share"}}
<div class="wws-share">
  <button type="button" class="wws-chip{{#if fact.everyone}} on{{/if}}" data-action="bestiaryShare" data-id="{{id}}" data-key="{{fact.key}}" data-user="*">
    <i class="fa-solid fa-users" inert></i> {{localize "WITCHWIND_SYSTEMS.Bestiary.Everyone"}}
  </button>
  {{#each fact.players}}
  <button type="button" class="wws-chip{{#if on}} on{{/if}}" data-action="bestiaryShare" data-id="{{../id}}" data-key="{{../fact.key}}" data-user="{{id}}"
          style="--wws-author: {{color}};">{{name}}</button>
  {{/each}}
</div>
{{/inline}}

<div class="wws-spread wws-bestiary">

  {{!-- Left: the creatures the party has met, grouped by kind as in the Witcher's bestiary --}}
  <section class="wws-page wws-page-list wws-beast-list">
    <header class="wws-beast-head">
      <h2>{{localize "WITCHWIND_SYSTEMS.Sections.bestiary"}}</h2>
      {{#if page.total}}<span class="wws-beast-count">{{page.total}}</span>{{/if}}
    </header>

    <label class="wws-search wws-beast-search">
      <i class="fa-solid fa-magnifying-glass" inert></i>
      <input type="search" data-focus-key="bestiary" value="{{page.search}}"
             placeholder="{{localize "WITCHWIND_SYSTEMS.Bestiary.Search"}}" aria-label="{{localize "WITCHWIND_SYSTEMS.Bestiary.Search"}}">
    </label>

    <div class="wws-list-scroll">
      {{#if page.empty}}
      <p class="wws-empty">{{#if page.search}}{{localize "WITCHWIND_SYSTEMS.Bestiary.NoMatches"}}{{else}}{{localize "WITCHWIND_SYSTEMS.Bestiary.Empty"}}{{/if}}</p>
      {{/if}}
      {{#each page.groups}}
      <section class="wws-beast-group">
        <button type="button" class="wws-beast-group-head" data-action="bestiaryGroup" data-group="{{key}}" aria-expanded="{{#if open}}true{{else}}false{{/if}}">
          <span class="wws-beast-group-name">{{label}}</span>
          <span class="wws-beast-group-count">{{count}}</span>
          <i class="fa-solid {{#if open}}fa-caret-up{{else}}fa-caret-down{{/if}}" inert></i>
        </button>
        {{#if open}}
        <ol class="wws-list wws-beast-rows">
          {{#each rows}}
          <li>
            <button type="button" class="wws-row wws-creature-row{{#if selected}} selected{{/if}}" data-action="bestiarySelect" data-id="{{id}}">
              <span class="wws-beast-thumb">{{#if img}}<img src="{{img}}" alt="" loading="lazy">{{else}}<i class="fa-solid fa-dragon" inert></i>{{/if}}</span>
              <span class="wws-row-text">
                <span class="wws-row-title">{{name}}</span>
                {{#if encountered}}<span class="wws-row-sub">{{localize "WITCHWIND_SYSTEMS.Bestiary.Times" count=encountered}}</span>{{/if}}
              </span>
              {{#if hidden}}<i class="fa-solid fa-eye-slash wws-row-mark" data-tooltip="WITCHWIND_SYSTEMS.HiddenFromPlayers"></i>{{/if}}
            </button>
          </li>
          {{/each}}
        </ol>
        {{/if}}
      </section>
      {{/each}}
    </div>

    {{#if isGM}}
    <p class="wws-drop-hint"><i class="fa-solid fa-grip-lines" inert></i> {{localize "WITCHWIND_SYSTEMS.Bestiary.DropHint"}}</p>
    {{/if}}
  </section>

  {{!-- Middle: the creature itself, and what it's vulnerable to --}}
  <section class="wws-beast-stage">
    {{#with page.creature as |c|}}
    <figure class="wws-beast-art">
      {{#if c.art}}<img src="{{c.art}}" alt="{{c.name}}">{{else}}<i class="fa-solid fa-dragon" inert></i>{{/if}}
    </figure>
    <div class="wws-beast-weak">
      <h3 class="wws-beast-weak-head">
        <span>{{localize "WITCHWIND_SYSTEMS.Bestiary.VulnerableTo"}}</span>
      </h3>
      {{#if c.vulnerable.known}}
      {{#if c.vulnerable.items.length}}
      <ul class="wws-beast-weak-icons">
        {{#each c.vulnerable.items}}
        <li style="--wws-i: {{@index}};" data-tooltip="{{label}}">{{#if img}}<img src="{{img}}" alt="{{label}}">{{else}}<i class="{{icon}}" aria-label="{{label}}"></i>{{/if}}</li>
        {{/each}}
      </ul>
      {{else}}
      <p class="wws-beast-weak-none">{{localize "WITCHWIND_SYSTEMS.Bestiary.NoneKnown"}}</p>
      {{/if}}
      {{#if c.vulnerable.hiddenFromPlayers}}<p class="wws-beast-weak-note">{{localize "WITCHWIND_SYSTEMS.Bestiary.HiddenTag"}}</p>{{/if}}
      {{else}}
      <p class="wws-beast-weak-none"><i class="fa-solid fa-lock" inert></i> {{localize "WITCHWIND_SYSTEMS.Bestiary.NotYetKnown"}}</p>
      {{/if}}
    </div>
    {{/with}}
  </section>

  {{!-- Right: the creature's page in the book --}}
  <section class="wws-page wws-page-detail wws-beast-book">
    <div class="wws-detail-scroll">
      {{#with page.creature as |c|}}
      <article class="wws-entry wws-creature" data-id="{{c.id}}">
        {{#if c.hidden}}<p class="wws-ribbon"><i class="fa-solid fa-eye-slash" inert></i> {{localize "WITCHWIND_SYSTEMS.HiddenFromPlayers"}}</p>{{/if}}

        {{#if @root.isGM}}
        <div class="wws-gm-bar">
          <span class="wws-gm-label">{{localize "WITCHWIND_SYSTEMS.GM"}}</span>
          <button type="button" class="wws-button" data-action="bestiaryEncounter" data-id="{{c.id}}">
            <i class="fa-solid fa-location-crosshairs" inert></i> {{localize "WITCHWIND_SYSTEMS.Bestiary.LogEncounterShort"}}
          </button>
          <button type="button" class="wws-tool" data-action="bestiaryEdit" data-id="{{c.id}}" data-tooltip="WITCHWIND_SYSTEMS.Edit"><i class="fa-solid fa-pen-to-square" inert></i></button>
          <button type="button" class="wws-tool" data-action="bestiaryVisible" data-id="{{c.id}}"
                  data-tooltip="{{#if c.hidden}}WITCHWIND_SYSTEMS.Reveal{{else}}WITCHWIND_SYSTEMS.Hide{{/if}}">
            <i class="fa-solid {{#if c.hidden}}fa-eye{{else}}fa-eye-slash{{/if}}" inert></i>
          </button>
          {{#if c.canRefresh}}
          <button type="button" class="wws-tool" data-action="bestiaryRefresh" data-id="{{c.id}}" data-tooltip="WITCHWIND_SYSTEMS.Bestiary.Refresh"><i class="fa-solid fa-rotate" inert></i></button>
          {{/if}}
          <span class="wws-gm-gap"></span>
          <button type="button" class="wws-tool wws-bad" data-action="bestiaryDelete" data-id="{{c.id}}" data-tooltip="WITCHWIND_SYSTEMS.Delete.Title"><i class="fa-solid fa-trash" inert></i></button>
        </div>
        {{/if}}

        <header class="wws-beast-title">
          <h1 class="wws-entry-title">{{c.name}}</h1>
          <p class="wws-byline">
            {{#if c.typeLabel}}{{c.typeLabel}}{{/if}}{{#if c.sizeLabel}}{{#if c.typeLabel}} · {{/if}}{{c.sizeLabel}}{{/if}}{{#if (or c.typeLabel c.sizeLabel)}} · {{/if}}
            {{#if c.encounteredCount}}{{localize "WITCHWIND_SYSTEMS.Bestiary.Times" count=c.encounteredCount}}{{else}}{{localize "WITCHWIND_SYSTEMS.Bestiary.NotYet"}}{{/if}}
          </p>
        </header>

        {{!-- The lore: the book's own words about the creature, written out first. --}}
        {{#with c.story as |story|}}
        <section class="wws-beast-story{{#unless (or story.known @root.isGM)}} wws-locked{{/unless}}">
          {{#if story.hiddenFromPlayers}}<span class="wws-fact-tag">{{localize "WITCHWIND_SYSTEMS.Bestiary.HiddenTag"}}</span>{{/if}}
          {{#if (or story.known @root.isGM)}}
          {{#if story.html}}<div class="wws-prose">{{{story.html}}}</div>
          {{else}}<p class="wws-empty wws-empty-small">{{localize "WITCHWIND_SYSTEMS.Bestiary.NothingRecorded"}}</p>{{/if}}
          {{else}}
          <p class="wws-fact-locked"><i class="fa-solid fa-lock" inert></i> {{localize "WITCHWIND_SYSTEMS.Bestiary.NotYetKnown"}}</p>
          {{/if}}
          {{#if @root.isGM}}{{> wws-beast-share fact=story id=c.id}}{{/if}}
        </section>
        {{/with}}

        <div class="wws-facts-grid wws-beast-facts">
          {{#each c.facts}}
          <section class="wws-fact{{#if wide}} wws-wide{{/if}}{{#unless (or known @root.isGM)}} wws-locked{{/unless}}">
            <header class="wws-fact-head">
              <i class="{{icon}}" inert></i>
              <h4>{{label}}</h4>
              {{#if hiddenFromPlayers}}<span class="wws-fact-tag">{{localize "WITCHWIND_SYSTEMS.Bestiary.HiddenTag"}}</span>{{/if}}
            </header>

            {{#if (or known @root.isGM)}}
              {{#if lines.length}}
              <dl class="wws-fact-lines">
                {{#each lines}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
              </dl>
              {{/if}}
              {{#if html}}<div class="wws-prose">{{{html}}}</div>{{/if}}
              {{#unless (or lines.length html)}}<p class="wws-empty wws-empty-small">{{localize "WITCHWIND_SYSTEMS.Bestiary.NothingRecorded"}}</p>{{/unless}}
            {{else}}
              <p class="wws-fact-locked"><i class="fa-solid fa-lock" inert></i> {{localize "WITCHWIND_SYSTEMS.Bestiary.NotYetKnown"}}</p>
            {{/if}}

            {{#if @root.isGM}}{{> wws-beast-share fact=this id=c.id}}{{/if}}
          </section>
          {{/each}}
        </div>

        {{#if c.encounters.length}}
        <h3 class="wws-rule-head">{{localize "WITCHWIND_SYSTEMS.Bestiary.Encounters"}}</h3>
        <ol class="wws-log wws-encounters">
          {{#each c.encounters}}
          <li class="wws-log-entry">
            <div class="wws-log-meta"><time>{{dateLabel}}</time></div>
            <p class="wws-encounter-place">{{place}}</p>
          </li>
          {{/each}}
        </ol>
        {{/if}}
      </article>
      {{else}}
      <p class="wws-empty wws-empty-page">
        <i class="fa-solid fa-dragon" inert></i>
        {{#if isGM}}{{localize "WITCHWIND_SYSTEMS.Bestiary.StartHint"}}{{else}}{{localize "WITCHWIND_SYSTEMS.Bestiary.NoneHint"}}{{/if}}
      </p>
      {{/with}}
    </div>
  </section>
</div>
